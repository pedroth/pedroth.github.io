:: 

function renderHTML(x, args) {
	const match = x.match(/```html([\s\S]*?)```/);
	if (!match) return x;

	const htmlCode = match[1].trim();
	const title = args?.[0] || "HTML Preview";

	const id = "nd-" + Math.random().toString(36).slice(2);

	return `
<details class="nd-widget" open>
  <summary class="nd-summary">${title}</summary>

  <div class="nd-tabs">
    <button onclick="ndTab('${id}','code')" class="active" id="${id}-btn-code">Code</button>
    <button onclick="ndTab('${id}','preview')" id="${id}-btn-preview">Preview</button>
  </div>

  <!-- CODE TAB (raw Nabladown rendering) -->
  <div id="${id}-code" class="nd-code">
    ${x}
  </div>

  <!-- PREVIEW TAB (rendered HTML) -->
  <div id="${id}-preview" class="nd-preview" style="display:none;">
    ${htmlCode}
  </div>

  <script>
    function ndTab(id, mode) {
      const code = document.getElementById(id + "-code");
      const preview = document.getElementById(id + "-preview");

      const btnCode = document.getElementById(id + "-btn-code");
      const btnPrev = document.getElementById(id + "-btn-preview");

      if (mode === "code") {
        code.style.display = "block";
        preview.style.display = "none";
        btnCode.classList.add("active");
        btnPrev.classList.remove("active");
      } else {
        code.style.display = "none";
        preview.style.display = "block";
        btnPrev.classList.add("active");
        btnCode.classList.remove("active");
      }
    }
  </script>
</details>
`;
}

MACROS = { renderHTML };
